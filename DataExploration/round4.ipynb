    "# IV vs moneyness (S/K): one point per (timestep, strike)\n",
    "clean = iv_df.dropna(subset=['iv']).copy()\n",
    "clean['moneyness'] = clean['spot'] / clean['strike']\n",
    "\n",
    "fig = go.Figure()\n",
    "for d in sorted(clean['day'].unique()):\n",
    "    sub = clean[clean['day'] == d]\n",
    "    fig.add_trace(go.Scattergl(\n",
    "        x=sub['moneyness'], y=sub['iv'], mode='markers',\n",
    "        name=f'day {d}', marker=dict(size=3, opacity=0.35),\n",
    "    ))\n",
    "\n",
    "# ATM reference line (S/K = 1)\n",
    "fig.add_vline(x=1.0, line=dict(color='gray', dash='dash'), annotation_text='ATM')\n",
    "\n",
    "fig.update_layout(\n",
    "    title='VEV implied volatility vs moneyness (S/K) — one point per timestep per strike',\n",
    "    xaxis_title='moneyness (spot / strike)',\n",
    "    yaxis_title='implied volatility (annualized)',\n",
    ")\n",
    "fig.show(renderer='browser')\n",
    "print(f'plotted {len(clean):,} points across {clean[\"strike\"].nunique()} strikes')"
