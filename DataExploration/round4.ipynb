   "source": [
    "## Implied Volatility Smile\n",
    "\n",
    "Treat each `VEV_<K>` as a European **call** on `VELVETFRUIT_EXTRACT` with strike `K` and `r = 0`.\n",
    "Back out Black-Scholes IV from the option mid and the underlying mid, then plot strike → IV.\n",
    "\n",
    "**Adjust `DAYS_TO_EXPIRY_AT_R3_D0_START`** to match actual competition rules — IV scales as 1/√T, so this shifts the level of the curve, not its shape."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "1619a01a",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "from math import log, sqrt, exp, erf\n",
    "\n",
    "def _norm_cdf(x):\n",
    "    return 0.5 * (1.0 + erf(x / sqrt(2.0)))\n",
    "\n",
    "def bs_call(S, K, T, sigma, r=0.0):\n",
    "    if sigma <= 0 or T <= 0 or S <= 0 or K <= 0:\n",
    "        return max(S - K, 0.0)\n",
    "    d1 = (log(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * sqrt(T))\n",
    "    d2 = d1 - sigma * sqrt(T)\n",
    "    return S * _norm_cdf(d1) - K * exp(-r * T) * _norm_cdf(d2)\n",
    "\n",
    "def iv_call(price, S, K, T, r=0.0, tol=1e-6, max_iter=80):\n",
    "    intrinsic = max(S - K * exp(-r * T), 0.0)\n",
    "    if price is None or np.isnan(price) or price <= intrinsic or S <= 0 or K <= 0 or T <= 0:\n",
    "        return np.nan\n",
    "    lo, hi = 1e-6, 5.0\n",
    "    for _ in range(max_iter):\n",
    "        mid = 0.5 * (lo + hi)\n",
    "        if bs_call(S, K, T, mid, r) > price:\n",
    "            hi = mid\n",
    "        else:\n",
    "            lo = mid\n",
    "        if hi - lo < tol:\n",
    "            break\n",
    "    return 0.5 * (lo + hi)"
   ]
  },
