    "import plotly.graph_objects as go\n",
    "\n",
    "# mean IV per (day, strike) -> one smile curve per day\n",
    "smile = iv_df.dropna(subset=['iv']).groupby(['day', 'strike'])['iv'].mean().reset_index()\n",
    "\n",
    "fig = go.Figure()\n",
    "for d in sorted(smile['day'].unique()):\n",
    "    sub = smile[smile['day'] == d].sort_values('strike')\n",
    "    fig.add_trace(go.Scatter(x=sub['strike'], y=sub['iv'], mode='lines+markers', name=f'day {d}'))\n",
    "\n",
    "# overall average across days\n",
    "overall = iv_df.dropna(subset=['iv']).groupby('strike')['iv'].mean().reset_index().sort_values('strike')\n",
    "fig.add_trace(go.Scatter(x=overall['strike'], y=overall['iv'], mode='lines+markers',\n",
    "                         name='all days', line=dict(width=3, color='black', dash='dash')))\n",
    "\n",
    "fig.update_layout(\n",
    "    title='VEV implied volatility smile — strike vs IV (daily mean)',\n",
    "    xaxis_title='strike', yaxis_title='implied vol (annualized)',\n",
    ")\n",
    "fig.show(renderer='browser')"
   ]
