    "# spot / strike over time, one line per strike\n",
    "mny = iv_df[['day', 'timestamp', 'strike', 'spot']].copy()\n",
    "mny['moneyness'] = mny['spot'] / mny['strike']\n",
    "mny['global_ts'] = mny['timestamp'] + (mny['day'] - mny['day'].min()) * TICKS_PER_DAY\n",
    "mny = mny.sort_values(['strike', 'global_ts'])\n",
    "\n",
    "fig = go.Figure()\n",
    "for K in sorted(mny['strike'].unique()):\n",
    "    sub = mny[mny['strike'] == K]\n",
    "    fig.add_trace(go.Scattergl(\n",
    "        x=sub['global_ts'], y=sub['moneyness'], mode='lines',\n",
    "        name=f'K={K}',\n",
    "    ))\n",
    "\n",
    "fig.add_hline(y=1.0, line=dict(color='gray', dash='dash'), annotation_text='ATM')\n",
    "\n",
    "fig.update_layout(\n",
    "    title='Moneyness over time (spot / strike) per VEV option',\n",
    "    xaxis_title='global timestamp', yaxis_title='spot / strike',\n",
    ")\n",
    "fig.show(renderer='browser')"
   ]
