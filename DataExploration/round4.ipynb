   "source": [
    "import re\n",
    "\n",
    "# --- parameters: adjust to match actual round-3 rules ---\n",
    "DAYS_TO_EXPIRY_AT_R3_D0_START = 5.0    # days until expiry at day 0, timestamp 0\n",
    "TICKS_PER_DAY = 1_000_000              # timestamps per simulated day\n",
    "\n",
    "def strike_of(name):\n",
    "    m = re.match(r'VEV_(\\d+)', name)\n",
    "    return int(m.group(1)) if m else None\n",
    "\n",
    "underlying = (per_product['VELVETFRUIT_EXTRACT'][['day', 'timestamp', 'mid_price']]\n",
    "              .rename(columns={'mid_price': 'spot'}))\n",
    "\n",
    "iv_frames = []\n",
    "for name in vev_products:\n",
    "    K = strike_of(name)\n",
    "    df = per_product[name][['day', 'timestamp', 'mid_price']].rename(columns={'mid_price': 'option_mid'})\n",
    "    df = df.merge(underlying, on=['day', 'timestamp'], how='inner')\n",
    "    df['strike'] = K\n",
    "    elapsed_days = df['day'] + df['timestamp'] / TICKS_PER_DAY\n",
    "    df['ttm_days'] = DAYS_TO_EXPIRY_AT_R3_D0_START - elapsed_days\n",
    "    df['ttm_years'] = df['ttm_days'] / 365.0\n",
    "    df['iv'] = [iv_call(p, s, K, t) for p, s, t in zip(df['option_mid'], df['spot'], df['ttm_years'])]\n",
    "    iv_frames.append(df)\n",
    "\n",
    "iv_df = pd.concat(iv_frames, ignore_index=True)\n",
    "print(f'rows={len(iv_df)}  finite IV={iv_df[\"iv\"].notna().sum()}')\n",
    "iv_df.head(50)"
   ]
  },
